#jinja2: trim_blocks: False
[Unit]
Description=AAP {{ aap_node_type }} local lifecycle (container systemd units)
After=network-online.target user@{{ aap_user_uid }}.service
Requires=user@{{ aap_user_uid }}.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aap-{{ aap_node_type }} start
ExecStop=/usr/local/bin/aap-{{ aap_node_type }} stop
{% if aap_node_type == 'redis' %}
TimeoutStartSec={{ aap_redis_ready_timeout_seconds | int + 60 }}
TimeoutStopSec={{ (aap_redis_failover_timeout_seconds | int * 3) + 600 }}
{% else %}
TimeoutStartSec=300
TimeoutStopSec=600
{% endif %}

[Install]
WantedBy=multi-user.target
