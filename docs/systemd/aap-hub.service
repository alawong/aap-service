# Reference system unit - deployed to /etc/systemd/system/aap-hub.service
[Unit]
Description=AAP hub local lifecycle (container systemd units)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aap-hub start
ExecStop=/usr/local/bin/aap-hub stop
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
