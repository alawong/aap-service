# Reference system unit - deployed to /etc/systemd/system/aap-eda.service
[Unit]
Description=AAP EDA local lifecycle (container systemd units)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aap-eda start
ExecStop=/usr/local/bin/aap-eda stop
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
