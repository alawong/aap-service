[Unit]
Description=AAP instance enable/disable (mesh, {{ aap_node_type }})
After=network-online.target{% for unit in aap_instance_after_units %} {{ unit }}{% endfor %}
{% if aap_instance_after_units | length > 0 %}
Requires={{ aap_instance_after_units | join(' ') }}
{% endif %}
Wants=network-online.target


[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredentialEncrypted=aap_token:/etc/credstore.encrypted/aap_token
PrivateMounts=yes
ExecStart=/usr/local/bin/aap-instance-{{ aap_node_type }} start
ExecStop=/usr/local/bin/aap-instance-{{ aap_node_type }} stop
TimeoutStartSec={{ aap_instance_api_ready_timeout_seconds + aap_instance_ready_timeout_seconds + 60 }}
TimeoutStopSec={{ aap_instance_api_ready_timeout_seconds + 60 }}

[Install]
WantedBy=multi-user.target
