# Reference system unit - deployed to /etc/systemd/system/aap-controller.service
[Unit]
Description=AAP controller local lifecycle (container systemd units)
After=network-online.target user@UID.service
Requires=user@UID.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aap-controller start
ExecStop=/usr/local/bin/aap-controller stop
TimeoutStartSec=300
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
